{
  "name": "nanaz-bot",
  "version": "3.2.0",
  "description": "A multi-purpose Discord bot built with TypeScript.",
  "keywords": [],
  "homepage": "https://www.saduwub.com/nanaz/",
  "bugs": {
    "url": "https://github.com/IzawaNanako/nanaz-bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IzawaNanako/nanaz-bot.git"
  },
  "license": "GPL-3.0-only",
  "author": "Wither (https://github.com/IzawaNanako)",
  "type": "module",
  "scripts": {
    "build": "tsc && swc src -d dist --strip-leading-paths && node -e \"require('fs-extra').copySync('src/locales', 'dist/locales')\"",
    "deploy-global": "node dist/deploy-commands-global.js",
    "deploy-guild": "node dist/deploy-commands-guild.js",
    "dev": "tsx watch src/index.ts",
    "rs-global": "node dist/rs-global-cmds.js",
    "rs-guild": "node dist/rs-guild-cmds.js",
    "syncdb": "node dist/syncdb.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "deepl-node": "^1.17.3",
    "discord-markdown-parser": "^1.3.1",
    "discord.js": "^14.26.4",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.3",
    "fuse.js": "^7.1.0",
    "i18next": "^26.3.5",
    "i18next-fs-backend": "^2.6.0",
    "node-schedule": "^2.1.1",
    "pg": "^8.16.3",
    "sequelize": "^6.37.8",
    "typescript": "^6.0.3",
    "uuid": "^14.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.32",
    "@types/node": "^26.6.2",
    "@types/node-schedule": "^2.1.7",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0"
  },
  "allowScripts": {
    "@swc/core@1.16.2": true,
    "esbuild@0.28.2": true
  }
}
